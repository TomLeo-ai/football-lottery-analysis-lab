# Football Lottery Analysis Lab backend environment example
#
# The Spring Boot app reads provider keys from the process environment.
# It does not automatically load this file. Use it as deployment reference or
# load it with your local shell tooling.

# OpenAI-compatible provider keys
OPENAI_API_KEY=replace-with-openai-key
AZURE_OPENAI_API_KEY=replace-with-azure-openai-key
DEEPSEEK_API_KEY=replace-with-deepseek-key
DASHSCOPE_API_KEY=replace-with-dashscope-key
ZHIPU_API_KEY=replace-with-zhipu-key
ARK_API_KEY=replace-with-volcengine-ark-key
MOONSHOT_API_KEY=replace-with-moonshot-key
GEMINI_API_KEY=replace-with-gemini-key
OPENROUTER_API_KEY=replace-with-openrouter-key
LITELLM_PROXY_API_KEY=replace-with-litellm-proxy-key
LOCAL_OPENAI_COMPATIBLE_API_KEY=replace-with-local-provider-key

# PowerShell example:
# $env:OPENAI_API_KEY="replace-with-openai-key"
# mvn -f apps/server/pom.xml spring-boot:run
